# GNU Make workspace makefile autogenerated by Premake

ifndef config
  config=debug_linux
endif

ifndef verbose
  SILENT = @
endif

ifeq ($(config),debug_linux)
  gitfluss_config = debug_linux

else ifeq ($(config),debug_windows)
  gitfluss_config = debug_windows

else ifeq ($(config),asan_linux)
  gitfluss_config = asan_linux

else ifeq ($(config),asan_windows)
  gitfluss_config = asan_windows

else ifeq ($(config),release_linux)
  gitfluss_config = release_linux

else ifeq ($(config),release_windows)
  gitfluss_config = release_windows

else
  $(error "invalid configuration $(config)")
endif

PROJECTS := gitfluss

.PHONY: all clean help $(PROJECTS) 

all: $(PROJECTS)

gitfluss:
ifneq (,$(gitfluss_config))
	@echo "==== Building gitfluss ($(gitfluss_config)) ===="
	@${MAKE} --no-print-directory -C . -f gitfluss.make config=$(gitfluss_config)
endif

clean:
	@${MAKE} --no-print-directory -C . -f gitfluss.make clean

help:
	@echo "Usage: make [config=name] [target]"
	@echo ""
	@echo "CONFIGURATIONS:"
	@echo "  debug_linux"
	@echo "  debug_windows"
	@echo "  asan_linux"
	@echo "  asan_windows"
	@echo "  release_linux"
	@echo "  release_windows"
	@echo ""
	@echo "TARGETS:"
	@echo "   all (default)"
	@echo "   clean"
	@echo "   gitfluss"
	@echo ""
	@echo "For more information, see https://github.com/premake/premake-core/wiki"